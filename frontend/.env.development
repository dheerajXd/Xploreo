# The Guide/Experience/Hotel/Partner portal domains still run on mocks until the backend grows
# the matching endpoints (guide-applications, guide-assignments, experience-bookings, schedule,
# tickets, upload, hotels, bookings). Remove a domain here once its real backend route exists.
# VITE_API_URL is left unset so it falls back to services/api.js's own default (…/api).
VITE_MOCKS=guide,partners,schedule,upload,hotels
